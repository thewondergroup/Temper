# Copy to temper-forms.env ONE LEVEL ABOVE the web root and fill in from the previous site's .env.
# Never commit the filled-in file.
APP_NAME="Temper Steak Restaurant"
BREVO_API_KEY=
# Sender address: must be a verified sender in Brevo
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Where contact and private hire enquiries are delivered
MAIL_TO_ADDRESS=
# Secret key that pairs with the site key used on the contact and private hire pages
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
